# dgx02 → fleet dispatch relay: keep the per-host bus tunnels alive.
#
# Runs ~/.local/bin/dispatch-tunnels, which launches one autossh per fleet bus,
# each forwarding a dgx02-local port to that host's LOOPBACK Agent Mail bus
# (127.0.0.1:8765 behind Tailscale Serve) via ssh — tank/germputer/llm-jp-2 over
# ProxyJump llm-jp, llm-jp direct. Forward targets are resolved by MagicDNS on
# the receiver/jump side, so the tunnels survive the fleet roaming. Loopback
# targets => tokenless. dgx02's dispatch env points AGENT_MAIL_URL_<HOST> at the
# matching 127.0.0.1:<port>. See docs/dispatch-dgx02-relay.md.
#
# Enable (user-space, no sudo):
#   loginctl enable-linger "$USER"          # survive logout
#   systemctl --user daemon-reload
#   systemctl --user enable --now dispatch-tunnel.service
#
# Ports: 9101 tank · 9102 germputer · 9103 llm-jp-2 · 9104 llm-jp.

[Unit]
Description=dispatch relay: autossh bus tunnels to the fleet (via llm-jp)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# AUTOSSH_GATETIME=0 → don't treat a fast first-connection failure as fatal;
# let autossh/systemd retry while llm-jp or the network settles.
Environment=AUTOSSH_GATETIME=0
ExecStart=%h/.local/bin/dispatch-tunnels
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
