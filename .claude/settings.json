{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "permissions": {
    "allow": [
      "Edit",
      "Edit(~/.claude/**)",
      "Edit(~/Downloads/**)",
      "Edit(~/git/**)",
      "Edit(~/Google_Drive/HRI-JP/projects/**)",
      "Edit(~/haru.md/**)",
      "Edit(~/projects/**)",
      "Read",
      "Read(*)",
      "Read(~/git/**)",
      "Read(~/haru.md/**)",
      "Read(~/projects/**)",
      "Search",
      "Skill",
      "Skill(*)",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "WebFetch",
      "WebSearch",
      "Write",
      "Write(~/.claude/**)",
      "Write(~/Downloads/**)",
      "Write(~/git/**)",
      "Write(~/Google_Drive/HRI-JP/projects/**)",
      "Write(~/haru.md/**)",
      "Write(~/projects/**)",
      "mcp__claude_ai_Gmail__*",
      "mcp__claude_ai_Google_Calendar__*",
      "mcp__google-workspace__*",
      "mcp__markitdown-mcp__*",
      "mcp__plugin_context7_context7__*",
      "Bash(awk *)",
      "Bash(bash *.sh)",
      "Bash(bash *.sh *)",
      "Bash(bash ~/.claude/**/*.sh)",
      "Bash(bash ~/.claude/**/*.sh *)",
      "Bash(brew *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(claude *)",
      "Bash(convert *)",
      "Bash(cp *)",
      "Bash(curl *)",
      "Bash(deface *)",
      "Bash(defaults read:*)",
      "Bash(diff *)",
      "Bash(docker *)",
      "Bash(du *)",
      "Bash(echo *)",
      "Bash(exiftool *)",
      "Bash(export *)",
      "Bash(fc-list)",
      "Bash(ffmpeg *)",
      "Bash(ffplay *)",
      "Bash(ffprobe *)",
      "Bash(file *)",
      "Bash(find)",
      "Bash(find *)",
      "Bash(gh *)",
      "Bash(git -C *)",
      "Bash(gitleaks git:*)",
      "Bash(grep *)",
      "Bash(head)",
      "Bash(head *)",
      "Bash(command -v *)",
      "Bash(jq *)",
      "Bash(ksdiff *)",
      "Bash(ln *)",
      "Bash(lnk *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(magick *)",
      "Bash(mediainfo *)",
      "Bash(mkdir)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(open *)",
      "Bash(pandoc *)",
      "Bash(pbcopy)",
      "Bash(pbcopy *)",
      "Bash(pbpaste)",
      "Bash(pbpaste *)",
      "Bash(printf *)",
      "Bash(pyright *)",
      "Bash(quarto *)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(ruff *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(sed *)",
      "Bash(sips *)",
      "Bash(soffice *)",
      "Bash(stat *)",
      "Bash(system_profiler SPFontsDataType)",
      "Bash(tail)",
      "Bash(tail *)",
      "Bash(time *)",
      "Bash(touch *)",
      "Bash(trash *)",
      "Bash(uv *)",
      "Bash(uv run *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(whisply *)"
    ],
    "deny": [
      "mcp__claude_ai_Mermaid_Chart__*",
      "mcp__apple-mail-patrickfreyer__search_emails",
      "mcp__apple-mail-patrickfreyer__get_email_thread",
      "mcp__apple-mail-patrickfreyer__list_inbox_emails",
      "mcp__apple-mail-patrickfreyer__get_mailbox_unread_counts",
      "mcp__apple-mail-patrickfreyer__list_accounts",
      "mcp__apple-mail-patrickfreyer__list_account_addresses",
      "mcp__apple-mail-patrickfreyer__list_mailboxes",
      "mcp__apple-mail-patrickfreyer__get_inbox_overview",
      "mcp__apple-mail-patrickfreyer__list_email_attachments",
      "mcp__apple-mail-patrickfreyer__get_statistics",
      "mcp__apple-mail-patrickfreyer__export_emails",
      "mcp__apple-mail-patrickfreyer__inbox_dashboard",
      "mcp__apple-mail-patrickfreyer__get_awaiting_reply",
      "mcp__apple-mail-patrickfreyer__get_needs_response",
      "mcp__apple-mail-patrickfreyer__get_top_senders",
      "mcp__apple-mail-patrickfreyer__reply_to_email",
      "mcp__apple-mail-patrickfreyer__create_rich_email_draft"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "enabledMcpjsonServers": [
    "slack"
  ],
  "skillOverrides": {
    "arxiv-submit": "off",
    "sync-latex": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/audit_python.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/git_gate.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); if [[ \"$f\" == *.py ]]; then ruff format \"$f\" 2>/dev/null || true; fi"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); if [[ \"$f\" == *.md ]]; then rumdl check --fix --config ~/.rumdl.toml \"$f\" 2>/dev/null || true; fi"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/panache_format.sh",
            "statusMessage": "Running panache..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/shellcheck_lint.sh",
            "statusMessage": "Running shellcheck..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "env GIT_OPTIONAL_LOCKS=0 node ~/.claude/statusline/claude-limitline/dist/index.js"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "hookify@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false,
    "che-ical-mcp@psychquant-claude-plugins": true,
    "slack@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "psychquant-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "PsychQuant/psychquant-claude-plugins"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "outputStyle": "Concise",
  "feedbackDrafts": "off",
  "syntaxHighlightingDisabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:selenized",
  "verbose": true,
  "preferredNotifChannel": "kitty",
  "teammateMode": "auto",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public — not queryable here (no remotes configured for this repo)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: unknown — origin/HEAD unset and no remotes configured for this repo",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: the local repository at /Users/eric/personal (no remotes configured; no additional orgs configured)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (personal/hobby use — repo /Users/eric/personal has no tracked files and no remotes)",
      "**Trusted repo**: the git repository at /Users/eric/personal (its working directory); it has no configured remotes",
      "**Org-specific CLIs**: None configured",
      "routine under /Users/eric/personal/ prefix: local file operations within this working directory"
    ]
  }
}
