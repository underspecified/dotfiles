#!/usr/bin/env zsh

### environment variables

# docker
export DOCKER_HOST=unix:///run/user/$(id -u)/docker.sock

# 1password
export OP_DIR="/opt/1Password"
export PATH="$OP_DIR:$PATH"

# ls colors
export LS_COLORS="$LS_COLORS:ow=1;7;34:st=30;44:su=30;41"
alias ls="ls --color=auto"

### aliases

# Emacs
alias emacs="TERM=xterm-color emacs -nw"

# pbcopy
alias pbcopy='xsel --clipboard --input'
alias pbpaste='xsel --clipboard --output'
alias pbclear='xsel --clipboard --clear'

# open
alias open='gio open'

# ssh-agent via keychain (persistent across shells). On Linux we no longer
# use the 1Password GUI agent; agent.conf is a no-op and SSH_AUTH_SOCK is
# set here. First-time setup: `keychain ~/.ssh/id_<host>` to register the key
# (handled by installers/linux/ssh_keys.sh).
if command -v keychain >/dev/null 2>&1; then
  eval "$(keychain --eval --quiet --agents ssh)"
fi

# dispatch → dgx02 sender env (machine-local; token in the sourced chmod-600 file)
[ -f ~/.config/dispatch/dgx02.env ] && source ~/.config/dispatch/dgx02.env
