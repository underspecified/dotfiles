# email + signingkey come from the machine-local include below,
# pulled from 1Password on bootstrap (see installers/all/op-config-pull.sh
# and bootstrap_finish.sh's pull_private_configs_from_1password step).

[include]
	path = ~/.config/git/identity.conf

[color]
	ui = auto

[branch]
	autosetupmerge = true

[rerere]
	enabled = true

[core]
	quotepath = false
	excludesfile = ~/.config/git/ignore
	whitespace = trailing-space,space-before-tab

[init]
	defaultBranch = main

[diff]
	renames = copies
	mnemonicprefix = true
	algorithm = histogram
	colorMoved = default
	tool = Kaleidoscope
	editor = "emacs -nw"

[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"

[difftool]
	prompt = false

[merge]
	stat = true
	# zdiff3 needs git >=2.35; diff3 works on every released git (1.7+)
	# and renders identical conflict markers (the "zealous" addition was
	# just collapsing of common lines inside conflict hunks).
	conflictstyle = diff3
	autostash = true
	tool = Kaleidoscope

[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustExitCode = true

[mergetool]
	prompt = false

[alias]
	ksreview = "!f() { local SHA=${1:-HEAD}; local BRANCH=${2:-main}; if [ $SHA == $BRANCH ]; then SHA=HEAD; fi; git difftool -y -t Kaleidoscope $BRANCH...$SHA; }; f"

[push]
	default = current

[gpg]
  format = ssh

[gpg "ssh"]
	program = ssh-keygen
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
  gpgsign = true

[pull]
	autostash = true
	rebase = true

[rebase]
	autostash = true
# Resolve gh via PATH, not an absolute path: `gh auth setup-git` hardcodes
# the machine where it ran (e.g. /home/e.nichols/.local/bin/gh on dgx02),
# which breaks this synced config on every other host. `!gh` runs under
# /bin/sh and picks up gh from PATH (homebrew on Mac, ~/.local/bin on dgx02).
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Overleaf is the one remote with no SSH option -- its git-bridge is HTTPS-only.
# Deliberately NO per-host block here: git's system gitconfig (shipped by Xcode
# / the CLT) already sets credential.helper=osxkeychain, which is encrypted at
# rest and is where the Overleaf token already lives. A per-host block with an
# empty `helper =` reset would MASK that global and break Overleaf auth in
# non-interactive sessions -- exactly what happened on 2026-08-05. On Linux no
# osxkeychain exists, so git falls back to a terminal prompt, which is the
# intended headless behaviour anyway.
