// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
//
// TEMPLATE: rendered to settings.json by the display render step
// (Linux: i3_update_config envsubst loop; macOS: render_ui_config). The two
// font sizes below are placeholders filled from the active display profile's
// FONT_ZED_UI / FONT_ZED_EDITOR. The rendered settings.json is gitignored —
// edit sizes in the profile, not here. Everything else is shared, edit freely.
{
  "ui_font_family": "iMWritingQuat Nerd Font Propo",
  "buffer_font_family": "iMWritingMono Nerd Font Propo",
  "buffer_font_weight": 400.0,
  "ui_font_size": ${FONT_ZED_UI},
  "buffer_font_size": ${FONT_ZED_EDITOR},

  "autosave": "on_focus_change",

  "theme": {
    "mode": "system",
    "light": "Base16 selenized-light",
    "dark": "Base16 selenized-dark",
  },

  "show_wrap_guides": true,
  "wrap_guides": [80, 120],
  "soft_wrap": "editor_width",
  "preferred_line_length": 80,

  "unstable.ui_density": "compact",
  "scrollbar": {
    "show": "auto",
  },

  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "terminal": {
    "dock": "right",
  },

  "title_bar": {
    "show_branch_name": false,
    "show_project_items": false,
    "show_onboarding_banner": false,
    //"show_user_picture": false,
    //"show_user_menu": false,
    //"show_sign_in": false,
    "show_menus": false,
    //"button_layout": "platform_default",
  },
}
