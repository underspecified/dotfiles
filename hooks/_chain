#!/usr/bin/env bash
# Usage: invoked by git as <hook-name>; every hook file here symlinks to this.
# Output: runs the repo's OWN hook of the same name, then any lnk-side guard.
#   pre-push also runs an opted-in repo's tracked hook from its remote's main.
#
# Why this exists: `core.hooksPath` REPLACES the hooks directory wholesale — it
# does not merge. Pointing it at a shared dir silently stops every per-repo
# `.git/hooks/*` on the machine (husky, pre-commit framework, whatever a cloned
# repo shipped), with no warning and no error. That failure is invisible until
# something that should have been blocked gets committed. So every hook here is
# a chain: repo's own hook first, lnk guard second.
#
# Load-bearing: `git rev-parse --git-path hooks/<name>` CANNOT be used to find
# the repo's own hook — it FOLLOWS core.hooksPath and returns this very script,
# which would exec itself forever. Verified 2026-09-21. Use --git-common-dir,
# which resolves to the repo's real .git regardless of hooksPath. Not --git-dir:
# in a linked worktree that is .git/worktrees/<name>, which has no hooks/.
set -uo pipefail

# Recursion guard: if a repo's own hook is itself this script (symlinked, or a
# repo that set hooksPath back here), stop rather than loop.
[ -n "${LNK_HOOK_CHAINED:-}" ] && exit 0

hook="$(basename "$0")"
commondir="$(git rev-parse --git-common-dir 2>/dev/null)" || exit 0
own="${commondir}/hooks/${hook}"

# Don't chain to ourselves: compare resolved directories, not paths as written.
own_is_self=0
if [ -x "${own}" ]; then
  own_dir="$(cd "$(dirname "${own}")" 2>/dev/null && pwd -P)" || own_dir=""
  self_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)" || self_dir=""
  [ -n "${own_dir}" ] && [ "${own_dir}" = "${self_dir}" ] && own_is_self=1
fi

# --- pre-push: the repo's tracked hook, taken from the remote's main (dotfiles#26)
# Repos whose .githooks/pre-push runs, one id per line, then a comment. An id
# is a hash of the lowercased owner/repo, so no private name lands in this
# public repo. Per repo, not per owner: a synced fork's refs carry its
# upstream's hook. To opt a repo in, merge its .githooks/pre-push first, then
# add its id here in a dotfiles PR:
#   printf %s owner/repo | tr '[:upper:]' '[:lower:]' | git hash-object --stdin
tracked_repos="
86644c22eb2249a8783f664a1557b3d0eb604dd4 # lab repo, #26
"

# Print the lowercased <owner>/<repo> of a github.com URL, or nothing.
github_repo() {
  local p
  case "${1:-}" in
    git@github.com:*) p="${1#git@github.com:}" ;;
    ssh://git@github.com/*) p="${1#ssh://git@github.com/}" ;;
    https://github.com/*) p="${1#https://github.com/}" ;;
    *) return 0 ;;
  esac
  p="$(printf %s "${p}" | tr '[:upper:]' '[:lower:]')"
  p="${p%.git}"
  case "${p}" in
    /* | */ | */*/* | *..*) ;;
    */*) printf %s "${p}" ;;
  esac
}

# Print the commit whose .githooks/pre-push this push runs, or nothing.
# Args: git's pre-push args, <remote> <url>.
tracked_commit() {
  local remote="${1:-}" url="${2:-}" repo id t listed=0 ref sha
  # A push to a bare URL passes the URL as both args: no remote-tracking refs.
  [ -n "${remote}" ] && [ "${remote}" != "${url}" ] || return 0
  repo="$(github_repo "${url}")"
  [ -n "${repo}" ] || return 0
  id="$(printf %s "${repo}" | git hash-object --stdin)" || return 0
  while read -r t _; do
    [ "${t}" = "${id}" ] && listed=1
  done <<<"${tracked_repos}"
  [ "${listed}" -eq 1 ] || return 0
  # The refs must come from the repo being pushed to, not from, say, a fork's
  # upstream in a url = upstream / pushurl = fork layout.
  [ "$(github_repo "$(git remote get-url "${remote}" 2>/dev/null)")" = "${repo}" ] || return 0
  # The default branch as of the last fetch: no network here. A branch's own
  # copy never runs, or it could edit or empty its own check.
  for ref in HEAD main; do
    sha="$(git rev-parse --verify --quiet "refs/remotes/${remote}/${ref}^{commit}")" || continue
    if git cat-file -e "${sha}:.githooks/pre-push" 2>/dev/null; then
      echo "${sha}"
      return 0
    fi
  done
  # Don't refuse: the repo's first hook PR has to be pushable.
  echo "pre-push: neither ${remote}/HEAD nor ${remote}/main has .githooks/pre-push; if ${remote}/HEAD is stale, run: git remote set-head ${remote} -a" >&2
}

if [ "${hook}" = "pre-push" ] && sha="$(tracked_commit "$@")" && [ -n "${sha}" ]; then
  export LNK_HOOK_CHAINED=1
  tmp="$(mktemp -d)" || exit 1
  trap 'rm -rf "${tmp}"' EXIT
  git show "${sha}:.githooks/pre-push" >"${tmp}/pre-push" || exit 1
  chmod 700 "${tmp}/pre-push"
  if [ -x "${own}" ] && [ "${own_is_self}" -eq 0 ]; then
    # stdin (the pushed refs) can be read only once: save it, feed it to both.
    cat >"${tmp}/stdin" || exit 1
    "${own}" "$@" <"${tmp}/stdin" || exit $?
    "${tmp}/pre-push" "$@" <"${tmp}/stdin"
  else
    "${tmp}/pre-push" "$@"
  fi
  rc=$?
  [ "${rc}" -eq 0 ] || echo "pre-push: refused by .githooks/pre-push from ${1}'s default branch (${sha:0:7})" >&2
  exit "${rc}"
fi

# Hooks with no lnk-side guard: hand off entirely. `exec` keeps stdin intact,
# which pre-push and post-rewrite depend on.
if [ "${hook}" != "pre-commit" ] && [ "${hook}" != "pre-merge-commit" ]; then
  if [ -x "${own}" ] && [ "${own_is_self}" -eq 0 ]; then
    export LNK_HOOK_CHAINED=1
    exec "${own}" "$@"
  fi
  exit 0
fi

# --- pre-commit / pre-merge-commit: repo's own hook first, then lnk guards ----
# Neither receives stdin, so running them in sequence is safe.
if [ -x "${own}" ] && [ "${own_is_self}" -eq 0 ]; then
  LNK_HOOK_CHAINED=1 "${own}" "$@" || exit $?
fi

# --- signingkey guard (dotfiles#10), commits and merge commits ---------------
# The global config signs from ~/.ssh/hri_jp. A repo's own user.signingkey
# beats it, and a public-key literal there needs an agent that holds the key,
# so the commit dies at signing ("Couldn't find key in agent?").
# A repo that doesn't sign never reaches the key, so it passes.
scope="$(git config --show-scope --get user.signingkey 2>/dev/null | cut -f1)"
case "${scope}" in
  local | worktree)
    if [ "$(git config --type=bool --get commit.gpgsign)" = "true" ] &&
      ! [ "$(git config --type=path --get user.signingkey)" -ef "${HOME}/.ssh/hri_jp" ]; then
      echo "${hook}: BLOCKED — this repo overrides the global signing key (~/.ssh/hri_jp):" >&2
      git config --show-origin --get user.signingkey >&2
      echo "  To fix: git config --${scope} --unset user.signingkey" >&2
      echo "  Or commit unsigned: git -c commit.gpgsign=false <commit|merge> ..." >&2
      exit 1
    fi
    ;;
esac

# The autoMode guard below is for pre-commit only.
[ "${hook}" = "pre-commit" ] || exit 0

# --- autoMode guard ----------------------------------------------------------
# Claude Code's /auto-mode-setup regenerates an `autoMode` block into
# .claude/settings.json. That block has carried employer name, internal paths,
# internal service names, sensitive-data locations and secrets-management
# details. ~/.config/lnk is a PUBLIC repo; stripping the block after a push does
# not unpublish it. autoMode belongs in the untracked ~/.claude/settings.local.json.
# Recurred 2026-09-11 (c0911b7) and again 2026-09-21.
blocked=0
while IFS= read -r file; do
  [ -n "${file}" ] || continue

  # Read the STAGED content, not the worktree copy — they can differ.
  staged="$(git show ":${file}" 2>/dev/null)" || continue

  if command -v jq >/dev/null 2>&1; then
    has_key="$(printf '%s' "${staged}" | jq -e 'has("autoMode")' 2>/dev/null)" || has_key="false"
  else
    # Fallback: an autoMode key at the top level of the object.
    if printf '%s' "${staged}" | grep -qE '^[[:space:]]*"autoMode"[[:space:]]*:'; then
      has_key="true"
    else
      has_key="false"
    fi
  fi

  if [ "${has_key}" = "true" ]; then
    echo "pre-commit: BLOCKED — '${file}' contains an \"autoMode\" key." >&2
    blocked=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)\.claude/settings\.json$' || true)

if [ "${blocked}" -ne 0 ]; then
  cat >&2 <<'MSG'

  autoMode blocks carry internal paths and service names. If this repo is
  public, committing and pushing publishes them; stripping it later does not
  unpublish it. autoMode belongs in ~/.claude/settings.local.json (gitignored).

  To fix:
    jq 'del(.autoMode)' .claude/settings.json > /tmp/s.json && mv /tmp/s.json .claude/settings.json
    git add .claude/settings.json

  To override deliberately (you have read the block and judged it safe):
    git commit --no-verify

MSG
  exit 1
fi

exit 0
