# Per-OS agent config + per-identity Host overlays (config.d entries are
# either lnk-managed per-OS or pulled from 1Password via installers/all).
Include ~/.ssh/config.d/*

### global settings

ForwardX11 no
ForwardX11Trusted no
TCPKeepAlive yes
# Keepalive (applies to all hosts — first-match-wins, set before any Host block):
# probe every 15s, tolerate ~2.5 min of loss before giving up. Defeats NAT/
# firewall idle drops and rides out brief network blips. For drops from sleep/
# roaming/TCP-reset (which keepalives can't prevent), use mosh — see germputer.
ServerAliveInterval 15
ServerAliveCountMax 10

### github

Host github.com
User git
Hostname ssh.github.com
Port 443

### dispatch — fast reuse across many ssh calls (auto-multiplexing)

Host germputer
ControlMaster auto
ControlPath ~/.ssh/cm-%r@%h:%p
ControlPersist 10m
ForwardAgent yes
# Keepalive inherited from the global block above (15s / 10). For frequent
# drops here (roaming/sleep/reset), prefer `mosh germputer` — survives the
# transport dying and reattaches your tmux/dispatch session automatically.

