#!/usr/bin/env bash
# Display profile for tank (macOS). Sourced by render_ui_config (selected by
# hostname when ~/.config/display/env isn't set). macOS handles HiDPI itself,
# so there's no SCALE / XFT_DPI here — just the literal font sizes (pt) and the
# kitty border px that the .in templates consume.

# Font sizes (pt)
export FONT_TERM=10            # kitty terminal
export FONT_ZED_UI=15          # zed editor UI chrome
export FONT_ZED_EDITOR=15      # zed editor buffer

# kitty window border (px) — set literally; no SCALE math on macOS.
export border_px=10
