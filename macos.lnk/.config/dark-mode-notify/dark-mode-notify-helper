#!/usr/bin/env bash
set -euo pipefail

LOG_DIR="${HOME}/tmp"
export PATH="${HOME}/.local/bin:${PATH}"

echo "DARKMODE: ${DARKMODE:-}" | tee -a "${LOG_DIR}/darkmode.log" 2>&1

if [[ -n "${DARKMODE+x}" ]]; then
    if [[ "${DARKMODE}" == "1" ]]; then
        mode="dark"
    else
        mode="light"
    fi
    (
        toggle_borders "${mode}"
        toggle_pdf_expert "${mode}"
        toggle_claude_theme "${mode}" --push
    ) | tee -a "${LOG_DIR}/darkmode.log" 2>&1
fi
