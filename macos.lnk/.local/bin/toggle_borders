#!/usr/bin/env bash
set -euo pipefail

toggle_borders() {
    "${HOME}/.config/borders/bordersrc_$1"
}

if [[ "${1:-}" == "dark" ]]; then
    mode="dark"
elif [[ "${1:-}" == "light" ]]; then
    mode="light"
elif [[ "$(get_macos_mode)" == "light" ]]; then
    mode="dark"
else
    mode="light"
fi

echo "toggle_borders => ${mode}"
toggle_borders "${mode}"
