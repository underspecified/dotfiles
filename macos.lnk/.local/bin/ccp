#!/usr/bin/env bash
# Usage: ccp <command> [args]   (Claude Code Profile — switch/launch by identity)
#
# Commands:
#   ccp run [-p <name>] [claude args...]  Launch claude with a profile's OAuth token
#   ccp use <name>                        Set the default active profile
#   ccp list                              List profiles (active marked with *)
#   ccp status                            Show active profile + token health
#   ccp add <name> <op-reference>         Map a profile to a 1Password secret ref
#   ccp rm  <name>                        Remove a profile mapping
#   ccp ref [name]                        Print the op:// ref for active/named profile
#   ccp stage [-p <name>]                 Persistently stage active/named token on the
#                                         local dispatch tmux server (future wakes inherit
#                                         it). Re-run after a reboot. launch_ws calls this.
#   ccp unstage                           Remove the staged token (wakes fall back to login)
#   ccp fleet list [--hosts "h1 h2"]      List dispatch tmux sessions (local + hosts)
#   ccp fleet switch <name> --match RE|--all [--apply] [--include-self] [--hosts "h1 h2"]
#                                         Relaunch matching dispatch sessions under <name>
#                                         (destroy + wake --headless; --continue resumes the
#                                          transcript under the new identity). Dry-run unless
#                                          --apply. Each relaunch is verified (with one retry)
#                                          so a destroy/wake race can't silently drop a
#                                          session. Current session excluded unless
#                                          --include-self (relaunched last via a detached
#                                          helper). LOCAL switches via the staged tmux global
#                                          env (persists); --hosts REMOTE switches via
#                                          dispatch's cold-start token injection (#127,
#                                          per-wake — not persistent across remote re-wakes).
#
# Tokens are long-lived OAuth tokens from `claude setup-token`, stored in 1Password
# and resolved at launch via `op read`. They never touch disk. CLAUDE_CODE_OAUTH_TOKEN
# is auth-precedence #5, so this also unsets ANTHROPIC_API_KEY/ANTHROPIC_AUTH_TOKEN
# (#3) which would otherwise win.
#
# Config (machine-local, not in git):
#   ${XDG_CONFIG_HOME:-~/.config}/ccp/profiles   lines: <name><TAB>op://vault/item/field
#   ${XDG_CONFIG_HOME:-~/.config}/ccp/active      single line: active profile name
set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/ccp"
PROFILES_FILE="${CONFIG_DIR}/profiles"
ACTIVE_FILE="${CONFIG_DIR}/active"

die() {
  echo "ccp: $*" >&2
  exit 1
}

ensure_config() {
  mkdir -p "${CONFIG_DIR}"
  [[ -f "${PROFILES_FILE}" ]] || : >"${PROFILES_FILE}"
}

# Print the op:// reference for a profile name. Returns non-zero if not found.
ref_for() {
  local name="$1"
  awk -F'\t' -v n="${name}" '$1 == n { print $2; found = 1 } END { exit !found }' \
    "${PROFILES_FILE}"
}

active_name() {
  [[ -f "${ACTIVE_FILE}" ]] && head -n1 "${ACTIVE_FILE}"
}

cmd_add() {
  local name="${1:-}" ref="${2:-}"
  [[ -n "${name}" && -n "${ref}" ]] || die "usage: ccp add <name> <op-reference>"
  [[ "${ref}" == op://* ]] || die "reference must be an op:// path (e.g. op://Private/claude-work/credential)"
  # Drop any existing line for this name, then append the new mapping.
  local tmp="${PROFILES_FILE}.tmp"
  awk -F'\t' -v n="${name}" '$1 != n' "${PROFILES_FILE}" >"${tmp}"
  printf '%s\t%s\n' "${name}" "${ref}" >>"${tmp}"
  mv "${tmp}" "${PROFILES_FILE}"
  echo "ccp: mapped '${name}' -> ${ref}"
}

cmd_rm() {
  local name="${1:-}"
  [[ -n "${name}" ]] || die "usage: ccp rm <name>"
  ref_for "${name}" >/dev/null || die "no such profile: ${name}"
  local tmp="${PROFILES_FILE}.tmp"
  awk -F'\t' -v n="${name}" '$1 != n' "${PROFILES_FILE}" >"${tmp}"
  mv "${tmp}" "${PROFILES_FILE}"
  [[ "$(active_name)" == "${name}" ]] && rm -f "${ACTIVE_FILE}"
  echo "ccp: removed '${name}'"
}

cmd_use() {
  local name="${1:-}"
  [[ -n "${name}" ]] || die "usage: ccp use <name>"
  ref_for "${name}" >/dev/null || die "no such profile: ${name} (add it with: ccp add ${name} <op-ref>)"
  echo "${name}" >"${ACTIVE_FILE}"
  echo "ccp: active profile -> ${name}"
}

cmd_list() {
  local active
  active="$(active_name || true)"
  if [[ ! -s "${PROFILES_FILE}" ]]; then
    echo "ccp: no profiles yet. Add one: ccp add work op://Private/claude-work/credential"
    return 0
  fi
  local name ref mark
  while IFS=$'\t' read -r name ref; do
    [[ -n "${name}" ]] || continue
    mark="  "
    [[ "${name}" == "${active}" ]] && mark="* "
    printf '%s%-12s %s\n' "${mark}" "${name}" "${ref}"
  done <"${PROFILES_FILE}"
}

cmd_ref() {
  local name="${1:-$(active_name || true)}"
  [[ -n "${name}" ]] || die "no active profile set (ccp use <name>)"
  ref_for "${name}" || die "no such profile: ${name}"
}

cmd_status() {
  local name ref
  name="$(active_name || true)"
  [[ -n "${name}" ]] || die "no active profile set (ccp use <name>)"
  ref="$(ref_for "${name}")" || die "active profile '${name}' has no mapping"
  printf 'active profile : %s\n' "${name}"
  printf 'secret ref     : %s\n' "${ref}"
  local token
  if token="$(op read "${ref}" 2>/dev/null)" && [[ -n "${token}" ]]; then
    printf 'token          : resolved OK (%d chars)\n' "${#token}"
  else
    printf 'token          : FAILED to resolve via op read (is 1Password signed in?)\n'
    return 1
  fi
}

cmd_run() {
  local name=""
  # Parse leading -p/--profile; everything after is passed to claude.
  if [[ "${1:-}" == "-p" || "${1:-}" == "--profile" ]]; then
    name="${2:-}"
    [[ -n "${name}" ]] || die "usage: ccp run -p <name> [claude args...]"
    shift 2
  else
    name="$(active_name || true)"
    [[ -n "${name}" ]] || die "no active profile (ccp use <name>) and no -p given"
  fi
  local ref token
  ref="$(ref_for "${name}")" || die "no such profile: ${name}"
  token="$(op read "${ref}" 2>/dev/null)" || die "failed to read token via op (sign in: op signin)"
  [[ -n "${token}" ]] || die "empty token for profile '${name}'"
  # OAuth token is precedence #5; clear higher-precedence env so the profile wins.
  unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
  export CLAUDE_CODE_OAUTH_TOKEN="${token}"
  command -v claude >/dev/null || die "claude not found on PATH"
  exec claude "$@"
}

usage() {
  cat <<'EOF'
Usage: ccp <command> [args]   (Claude Code Profile — switch/launch by identity)

  ccp run [-p <name>] [claude args...]  Launch claude with a profile's OAuth token
  ccp use <name>                        Set the default active profile
  ccp list                              List profiles (active marked with *)
  ccp status                            Show active profile + token health
  ccp add <name> <op-reference>         Map a profile to a 1Password secret ref
  ccp rm  <name>                        Remove a profile mapping
  ccp ref [name]                        Print the op:// ref for active/named profile
  ccp stage [-p <name>]                 Persistently stage active/named token on the local
                                        dispatch tmux server so future `dispatch wake`s
                                        inherit it. Survives suspend/re-wake but not a
                                        server restart — re-run after reboot (launch_ws does).
  ccp unstage                           Remove the staged token (new wakes fall back to the
                                        keychain login).
  ccp fleet list [--hosts "h1 h2"]      List dispatch tmux sessions (local + given hosts)
  ccp fleet switch <name> --match RE|--all [--apply] [--include-self] [--hosts "h1 h2"]
                                        Relaunch matching dispatch sessions under <name>.
                                        destroy + wake --headless; --continue resumes the
                                        transcript under the new identity. Dry-run unless
                                        --apply. Each relaunch is verified with one retry
                                        (no silent destroy/wake-race drops). Current session
                                        excluded unless --include-self (relaunched last via
                                        a detached helper; reattach with `dispatch wake
                                        <path> --here`). LOCAL: token staged PERSISTENTLY on
                                        the local bus (records profile active) so re-wakes
                                        stay switched; clear with `ccp unstage`. --hosts:
                                        REMOTE switches via dispatch cold-start token
                                        injection (#127) — per-wake, NOT persistent across
                                        remote re-wakes (a remote reboot/re-wake reverts to
                                        the box credential; re-run switch to re-apply).
EOF
}

# ---- fleet: relaunch dispatch-managed sessions under a profile ------------

DISPATCH_SOCKET="dispatch"

# Emit "name<TAB>path" for every live dispatch session in a scope, or nothing.
# $1 = host ("" = local). Remote uses the same -L dispatch socket over ssh.
fleet_sessions() {
  local host="${1:-}"
  if [[ -z "${host}" ]]; then
    tmux -L "${DISPATCH_SOCKET}" list-sessions \
      -F '#{session_name}	#{session_path}' 2>/dev/null
  else
    # shellcheck disable=SC2029  # DISPATCH_SOCKET is a fixed literal; client-side expand is intended
    ssh "${host}" "tmux -L ${DISPATCH_SOCKET} list-sessions -F '#{session_name}	#{session_path}'" 2>/dev/null
  fi
}

# Just the session paths for a scope (one list call; for presence checks).
fleet_paths() { fleet_sessions "${1:-}" | cut -f2; }

# Name of the session ccp is running inside (empty if not in a dispatch pane).
fleet_self() {
  [[ -n "${TMUX:-}" ]] || return 0
  tmux display-message -p '#{session_name}' 2>/dev/null || true
}

# dispatch target string for a (host,path): "host:path" or bare "path".
_dtarget() { [[ -n "${1}" ]] && printf '%s:%s' "${1}" "${2}" || printf '%s' "${2}"; }

# Stage the OAuth token on the LOCAL dispatch tmux server so freshly-waked local
# sessions inherit it via the tmux global env (macOS propagates it to new panes).
# LOCAL ONLY: on the Linux remotes, tmux does NOT propagate `setenv -g` to new
# panes, so remote switching goes through dispatch's cold-start injection instead
# (DISPATCH_WAKE_OAUTH_TOKEN in relaunch_one) — never staged on a remote bus.
stage_token() { # token profile   (local only)
  local token="${1}" profile="${2:-}"
  tmux -L "${DISPATCH_SOCKET}" setenv -g CLAUDE_CODE_OAUTH_TOKEN "${token}"
  tmux -L "${DISPATCH_SOCKET}" setenv -gu ANTHROPIC_API_KEY 2>/dev/null || true
  # CCP_PROFILE labels the session's account so the statusline (limitline) can
  # pick the right per-account usage credential. Cheap, non-secret.
  [[ -n "${profile}" ]] && tmux -L "${DISPATCH_SOCKET}" setenv -g CCP_PROFILE "${profile}"
}

# Strip the staged token from a scope's dispatch server.
unstage_token() { # host
  local host="${1}"
  if [[ -z "${host}" ]]; then
    tmux -L "${DISPATCH_SOCKET}" setenv -gu CLAUDE_CODE_OAUTH_TOKEN 2>/dev/null || true
    tmux -L "${DISPATCH_SOCKET}" setenv -gu CCP_PROFILE 2>/dev/null || true
  else
    # shellcheck disable=SC2029  # DISPATCH_SOCKET is a fixed literal; client-side expand is intended
    ssh "${host}" "tmux -L ${DISPATCH_SOCKET} setenv -gu CLAUDE_CODE_OAUTH_TOKEN 2>/dev/null; tmux -L ${DISPATCH_SOCKET} setenv -gu CCP_PROFILE 2>/dev/null; true" 2>/dev/null || true
  fi
}

# Persistently stage the active/named profile token on the LOCAL dispatch tmux
# server so every future `dispatch wake` inherits it — the durable half of the
# profile switch. Staging lives in the tmux server's global env: it survives
# suspend/resume and re-wakes, but NOT a server restart (reboot / kill-server),
# so re-run this after a reboot (launch_ws does). The token sits in the dispatch
# server's global env (same-uid readable, same as the resolved op secret) until
# `ccp unstage` or an overwriting stage.
cmd_stage() {
  local name=""
  if [[ "${1:-}" == "-p" || "${1:-}" == "--profile" ]]; then
    name="${2:-}"; [[ -n "${name}" ]] || die "usage: ccp stage [-p <name>]"; shift 2
  else
    name="$(active_name || true)"
    [[ -n "${name}" ]] || die "no active profile (ccp use <name>) and no -p given"
  fi
  local ref token
  ref="$(ref_for "${name}")" || die "no such profile: ${name}"
  token="$(op read "${ref}" 2>/dev/null)" || die "failed to read token for '${name}' via op (sign in: op signin)"
  [[ -n "${token}" ]] || die "empty token for profile '${name}'"
  stage_token "${token}" "${name}"
  echo "ccp: staged '${name}' on local dispatch tmux server (persists until reboot or 'ccp unstage')"
}

cmd_unstage() {
  unstage_token ""
  echo "ccp: unstaged token from local dispatch tmux server (new wakes fall back to keychain login)"
}

# destroy + wake --headless one target (host "" = local).
# LOCAL: the account comes from the staged tmux global env (stage_token).
# REMOTE: tmux global env doesn't propagate on Linux, so inject the token via
# dispatch's cold-start wrapper — DISPATCH_WAKE_OAUTH_TOKEN (delivered 0600 over
# ssh stdin, #127) + DISPATCH_WAKE_CCP_PROFILE label — set for this wake only.
relaunch_one() { # host path [token] [profile]
  local host="${1}" tgt; tgt="$(_dtarget "${1}" "${2}")"
  dispatch -C "${tgt}" destroy >/dev/null 2>&1 || true
  if [[ -n "${host}" ]]; then
    DISPATCH_WAKE_OAUTH_TOKEN="${3:-}" DISPATCH_WAKE_CCP_PROFILE="${4:-}" \
      dispatch -C "${tgt}" wake --headless >/dev/null 2>&1 || true
  else
    dispatch -C "${tgt}" wake --headless >/dev/null 2>&1 || true
  fi
}

# Print "<mark><target>" for every session in a scope (• marks self, local).
_fleet_print_scope() { # host self
  local host="${1}" self="${2}" name path mark any=0
  while IFS=$'\t' read -r name path; do
    [[ -n "${name}" ]] || continue
    any=1; mark="  "
    [[ -z "${host}" && "${name}" == "${self}" ]] && mark="• "
    printf '%s%s\n' "${mark}" "$(_dtarget "${host}" "${path}")"
  done < <(fleet_sessions "${host}")
  [[ "${any}" -eq 1 ]] || echo "  (no sessions on -L ${DISPATCH_SOCKET})"
}

cmd_fleet_list() {
  local -a hosts=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --hosts) IFS=', ' read -r -a hosts <<<"${2:-}"; shift 2 ;;
      *) die "unknown flag: $1 (usage: ccp fleet list [--hosts \"h1 h2\"])" ;;
    esac
  done
  local self; self="$(fleet_self)"
  echo "local:"; _fleet_print_scope "" "${self}"
  # Index loop (not "${hosts[@]}"): bash 3.2 errors on empty-array @-expansion under set -u.
  local i
  for ((i = 0; i < ${#hosts[@]}; i++)); do
    [[ -n "${hosts[$i]}" ]] || continue
    echo "${hosts[$i]}:"; _fleet_print_scope "${hosts[$i]}" "${self}"
  done
}

# Daemonized self relaunch. Switching the CURRENT session can't be done inline
# (destroying our own tmux session kills ccp before it can re-wake). So we spawn
# a helper that reparents to init (subshell exits → nohup'd child survives the
# self-destroy), then recreates self --headless under the already-staged token
# (which persists — see the staging note above). Reattach the window after with
# `dispatch wake <path> --here`.
_launch_self_helper() { # self_path
  local sp="${1}" helper
  helper="$(mktemp "${TMPDIR:-/tmp}/ccp-self-relaunch.XXXXXX.sh")"
  cat >"${helper}" <<HELPER
#!/usr/bin/env bash
set -uo pipefail
sp='${sp}'
socket='${DISPATCH_SOCKET}'
sleep 2                                   # let the parent ccp finish + exit
dispatch -C "\${sp}" destroy >/dev/null 2>&1 || true
sleep 1
dispatch -C "\${sp}" wake --headless >/dev/null 2>&1 || true
for _ in \$(seq 1 30); do                 # confirm it came back up
  tmux -L "\${socket}" list-sessions -F '#{session_path}' 2>/dev/null | grep -Fxq "\${sp}" && break
  sleep 0.5
done
rm -f "\$0"
HELPER
  chmod +x "${helper}"
  ( nohup bash "${helper}" >/tmp/ccp-self-relaunch.log 2>&1 & )
}

cmd_fleet_switch() {
  local profile="${1:-}"
  [[ -n "${profile}" ]] || die "usage: ccp fleet switch <name> --match RE|--all [--apply] [--include-self] [--hosts \"h1 h2\"]"
  shift
  local match="" want_all=0 apply=0 include_self=0
  local -a hosts=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --match) match="${2:-}"; [[ -n "${match}" ]] || die "--match needs a regex"; shift 2 ;;
      --all) want_all=1; shift ;;
      --apply) apply=1; shift ;;
      --include-self) include_self=1; shift ;;
      --hosts) IFS=', ' read -r -a hosts <<<"${2:-}"; [[ "${#hosts[@]}" -gt 0 ]] || die "--hosts needs a host list"; shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  [[ -n "${match}" || "${want_all}" -eq 1 ]] || \
    die "refusing to act on the whole fleet implicitly: pass --match <regex> or --all"

  local ref token
  ref="$(ref_for "${profile}")" || die "no such profile: ${profile}"
  # Resolve the token up front so we fail before touching any session.
  token="$(op read "${ref}" 2>/dev/null)" || die "failed to read token for '${profile}' via op"
  [[ -n "${token}" ]] || die "empty token for profile '${profile}'"

  local self; self="$(fleet_self)"

  # Scopes: index 0 = local (""), 1.. = each --hosts entry. Plain indexed array
  # + C-style index loops throughout: bash 3.2 errors on "${empty[@]}" under
  # set -u and has no associative arrays, so we avoid both.
  local -a scopes; scopes[0]=""
  local i
  for ((i = 0; i < ${#hosts[@]}; i++)); do
    [[ -n "${hosts[$i]}" ]] && scopes[${#scopes[@]}]="${hosts[$i]}"
  done

  # Collect non-self targets into PARALLEL arrays (t_sidx = scope index, t_path).
  # Parallel arrays, not a "host<TAB>path" string: a tab is IFS-whitespace, so
  # `read` would silently drop the empty local-host field and mangle the path.
  local -a t_sidx=() t_path=()
  local self_path="" si sc name path
  for ((si = 0; si < ${#scopes[@]}; si++)); do
    sc="${scopes[$si]}"
    while IFS=$'\t' read -r name path; do
      [[ -n "${name}" ]] || continue
      if [[ -z "${sc}" && "${name}" == "${self}" ]]; then self_path="${path}"; continue; fi
      if [[ -n "${match}" && ! "${path}" =~ ${match} ]]; then continue; fi
      t_sidx[${#t_sidx[@]}]="${si}"
      t_path[${#t_path[@]}]="${path}"
    done < <(fleet_sessions "${sc}")
  done

  local do_self=0
  [[ "${include_self}" -eq 1 && -n "${self_path}" ]] && do_self=1

  [[ "${#t_path[@]}" -gt 0 || "${do_self}" -eq 1 ]] || die "no matching sessions"

  if [[ "${apply}" -eq 0 ]]; then
    echo "DRY RUN — would relaunch under '${profile}' (destroy + wake --headless):"
    for ((i = 0; i < ${#t_path[@]}; i++)); do
      printf '  %s\n' "$(_dtarget "${scopes[${t_sidx[$i]}]}" "${t_path[$i]}")"
    done
    [[ "${do_self}" -eq 1 ]] && printf '  %s   (SELF — relaunched last via detached helper)\n' "${self_path}"
    echo "Re-run with --apply to execute."
    return 0
  fi

  command -v dispatch >/dev/null || die "dispatch not found on PATH"

  # Which scope indices actually have work (so we only stage where needed).
  local -a stage_idx=()
  local hit j
  for ((si = 0; si < ${#scopes[@]}; si++)); do
    hit=0
    [[ -z "${scopes[$si]}" && "${do_self}" -eq 1 ]] && hit=1
    for ((j = 0; j < ${#t_sidx[@]}; j++)); do
      [[ "${t_sidx[$j]}" -eq "${si}" ]] && { hit=1; break; }
    done
    [[ "${hit}" -eq 1 ]] && stage_idx[${#stage_idx[@]}]="${si}"
  done

  # LOCAL staging is PERSISTENT (no unstage on exit): the token stays on the local
  # dispatch tmux global env so future LOCAL wakes (suspend/resume, good-morning,
  # crash-restart) keep inheriting it. Clear with `ccp unstage` or an overwriting
  # switch; survives suspend but not a server restart (launch_ws re-stages after
  # reboot). REMOTE scopes are NOT staged here — Linux tmux doesn't propagate the
  # global env, so remote gets the token per-wake via relaunch_one's
  # DISPATCH_WAKE_* injection (not persistent across remote re-wakes; see #126).
  local k
  for ((k = 0; k < ${#stage_idx[@]}; k++)); do
    [[ -z "${scopes[${stage_idx[$k]}]}" ]] && stage_token "${token}" "${profile}"
  done

  # Record the switched-to profile as active so `ccp stage` (e.g. from launch_ws
  # after a reboot) re-stages the same one.
  echo "${profile}" >"${ACTIVE_FILE}"

  # Relaunch pass (non-self). token/profile used only for remote targets (local
  # inherits the staged tmux global env); see relaunch_one.
  for ((i = 0; i < ${#t_path[@]}; i++)); do
    echo "==> $(_dtarget "${scopes[${t_sidx[$i]}]}" "${t_path[$i]}")"
    relaunch_one "${scopes[${t_sidx[$i]}]}" "${t_path[$i]}" "${token}" "${profile}"
  done

  # Settle (remote cold-start is slower than local), then verify + one retry.
  local settle=5; [[ "${#hosts[@]}" -gt 0 ]] && settle=12
  sleep "${settle}"

  # present_paths[scope_idx] = newline-joined paths live in that scope.
  local -a present_paths
  _refresh() { local s; for ((s = 0; s < ${#scopes[@]}; s++)); do present_paths[s]="$(fleet_paths "${scopes[$s]}")"; done; }
  _present() { grep -Fxq "${2}" <<<"${present_paths[$1]:-}"; } # $1=scope idx, $2=path

  _refresh
  local -a miss=()
  for ((i = 0; i < ${#t_path[@]}; i++)); do
    _present "${t_sidx[$i]}" "${t_path[$i]}" || miss[${#miss[@]}]="${i}"
  done
  if [[ "${#miss[@]}" -gt 0 ]]; then
    echo "ccp: ${#miss[@]} session(s) did not come up — retrying..." >&2
    for ((k = 0; k < ${#miss[@]}; k++)); do
      i="${miss[$k]}"
      relaunch_one "${scopes[${t_sidx[$i]}]}" "${t_path[$i]}" "${token}" "${profile}"
    done
    sleep "${settle}"
    _refresh
  fi

  # Final report.
  local ok=0 fail=0
  for ((i = 0; i < ${#t_path[@]}; i++)); do
    if _present "${t_sidx[$i]}" "${t_path[$i]}"; then
      ok=$((ok + 1))
    else
      fail=$((fail + 1)); echo "ccp: FAILED to confirm $(_dtarget "${scopes[${t_sidx[$i]}]}" "${t_path[$i]}")" >&2
    fi
  done

  # Self last, via the detached helper (survives its own destroy).
  if [[ "${do_self}" -eq 1 ]]; then
    _launch_self_helper "${self_path}"
    echo "ccp: self relaunch scheduled — this window's session restarts under '${profile}'"
    echo "ccp: reattach with: dispatch wake ${self_path} --here"
  fi

  if [[ "${fail}" -gt 0 ]]; then
    echo "ccp: relaunched ${ok}/$((ok + fail)) session(s) under '${profile}' (${fail} failed — see above)."
  else
    echo "ccp: relaunched ${ok} session(s) under '${profile}'."
  fi
}

cmd_fleet() {
  local sub="${1:-list}"
  [[ $# -gt 0 ]] && shift
  case "${sub}" in
    list | ls) cmd_fleet_list "$@" ;;
    switch) cmd_fleet_switch "$@" ;;
    *) die "usage: ccp fleet <list|switch> ..." ;;
  esac
}

main() {
  ensure_config
  local cmd="${1:-}"
  [[ $# -gt 0 ]] && shift
  case "${cmd}" in
    run) cmd_run "$@" ;;
    use) cmd_use "$@" ;;
    list | ls) cmd_list "$@" ;;
    status) cmd_status "$@" ;;
    add) cmd_add "$@" ;;
    rm) cmd_rm "$@" ;;
    ref) cmd_ref "$@" ;;
    stage) cmd_stage "$@" ;;
    unstage) cmd_unstage "$@" ;;
    fleet) cmd_fleet "$@" ;;
    "" | -h | --help | help) usage ;;
    *) die "unknown command: ${cmd} (try: ccp help)" ;;
  esac
}

main "$@"
