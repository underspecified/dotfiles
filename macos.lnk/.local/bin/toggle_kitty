#!/usr/bin/env bash
set -euo pipefail

toggle_kitty() {
    if [[ "$1" == "dark" ]]; then
        theme="Selenized Dark"
    else
        theme="Selenized Light"
    fi
    cmd=(/opt/homebrew/bin/kitten themes
        --config-file-name=themes.conf
        --reload-in=all)
    "${cmd[@]}" "${theme}" \
        || "${cmd[@]}" --cache-age=-1 "${theme}"
}

if [[ "${1:-}" == "dark" ]]; then
    mode="dark"
elif [[ "${1:-}" == "light" ]]; then
    mode="light"
elif [[ "$(get_macos_mode)" == "light" ]]; then
    mode="dark"
else
    mode="light"
fi

echo "toggle_kitty => ${mode}"
toggle_kitty "${mode}"
