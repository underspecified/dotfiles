#!/bin/bash

launch_ws() {
    h=$1
    shift 1

    kitten @ launch --type=tab --title=$h
    [[ "$BTOP" ]] && kitten @ launch --match=title:$h \
        mosh $h -- sh -c 'tmux a -t btop || tmux new-session -t btop btop; exec $SHELL'
    [[ "$NVITOP" ]] && kitten @ launch --match=title:$h \
        mosh $h -- sh -c 'tmux a -t nvitop || tmux new-session -t nvitop nvitop; exec $SHELL'

    for d in "$@"; do
        kitten @ launch --match=title:$h --env DISPATCH_REMOTE_MOSH=1 dispatch -C $h:$d wake
        sleep 5
    done

    kitten @ goto-layout --match=title:$h horizontal
    sleep 5
    kitten @ close-window --match=num:0
    sleep 5
}

# No `ccp stage` here: local (tank) sessions use the keychain login, because
# Claude in Chrome and computer-use only appear in sessions WITHOUT a staged
# CLAUDE_CODE_OAUTH_TOKEN (Eric, 2026-10-06). Remote hosts keep whatever
# `ccp fleet switch --hosts` last staged (persists until their next reboot).

BTOP=0 NVITOP=0 launch_ws localhost '~/projects' '~/projects/cambridge' '~/projects/llm'  '~/projects/settings' '~/haru.md'
BTOP=1 NVITOP=1 launch_ws dgx02 '~/git/llm_eval'
BTOP=1 NVITOP=1 launch_ws llm-jp '~/git/apps' '~/git/llm_eval'
BTOP=1 NVITOP=1 launch_ws llm-jp-2 '~/git/apps' '~/git/llm_eval'
BTOP=1 NVITOP=1 launch_ws germputer '~/git/apps' '~/git/llm_eval'
BTOP=1 NVITOP=1 launch_ws haru-4090 '~/git/apps' '~/git/llm_eval'
BTOP=1 NVITOP=1 launch_ws haru-5090 '~/git/apps' '~/git/llm_eval'
