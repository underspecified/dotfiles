#!/usr/bin/env bash
# Refresh yabai when tabs in Finder/Terminal/etc. spawn or move windows.
set -euo pipefail

PATH="/opt/homebrew/bin:${PATH}"
SCRIPTS_DIR="$(realpath "$(dirname "${BASH_SOURCE[0]:-$0}")")"

APPS=(
    "CotEditor"
    "Finder"
    "Terminal"
    "Typora"
)

EVENTS=(
    "window_moved"
    "window_resized"
)

for app in "${APPS[@]}"; do
    for event in "${EVENTS[@]}"; do
        yabai -m signal --remove "${event}_${app}"
        yabai -m signal --add \
            label="${event}_${app}" \
            app="^${app}$" \
            event="${event}" \
            action="${SCRIPTS_DIR}/yabai_refresh_space"
    done
done
