#!/usr/bin/env bash
set -euo pipefail

toggle_zed() {
    sed -i.bak -r "s/\"mode\": \".+\"/\"mode\": \"$1\"/" \
        "${HOME}/.config/zed/settings.json"
}

if [[ "${1:-}" == "dark" ]]; then
    mode="dark"
elif [[ "${1:-}" == "light" ]]; then
    mode="light"
elif [[ "$(get_macos_mode)" == "light" ]]; then
    mode="dark"
else
    mode="light"
fi

echo "toggle_zed => ${mode}"
toggle_zed "${mode}"
