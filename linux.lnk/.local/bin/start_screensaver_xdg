#!/usr/bin/env bash
# wallpaper var comes from sourced .env at runtime.
# shellcheck disable=SC2154
set -euo pipefail

LOCK_MIN=5
IDLE_MIN=10
IDLE_SEC=$(( IDLE_MIN * 60 ))

mode="$(darkman get)"
# shellcheck source=/dev/null
source "$HOME/.local/share/colors/selenized_${mode}.env"

gsettings set org.gnome.desktop.background picture-uri "file://${wallpaper}"

xset dpms "${IDLE_SEC}"
GDK_BACKEND=x11 gnome-screensaver &
xautolock -time "${LOCK_MIN}" -locker "${HOME}/.local/bin/lock_screen_xdg"
"${HOME}/.local/bin/lock_screen_xdg"
