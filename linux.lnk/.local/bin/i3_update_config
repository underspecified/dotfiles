#!/usr/bin/env bash
# All env vars consumed below (SCALE, FONT_*, BASE_*, XFT_DPI, wallpaper)
# come from the dynamically-sourced .env files at runtime; shellcheck
# can't see them, so silence the SC2153/SC2154 false positives.
# shellcheck disable=SC2153,SC2154

set -euo pipefail
shopt -s nullglob

export mode="${1:-$(darkman get)}"
# shellcheck source=/dev/null
source "$HOME/.local/share/colors/selenized_${mode}.env"

# Per-host display profile is selected by ~/.config/display/env, a symlink
# managed by setup_display.sh (untracked; gitignored). All other scripts
# source this same path -- one symlink, one source of truth.
env_link="$HOME/.config/display/env"
if [[ ! -e "$env_link" ]]; then
    echo "error: $env_link missing -- run setup_display.sh to pick a profile" >&2
    exit 1
fi
# shellcheck source=/dev/null
source "$env_link"

# Scale a pixel base value: round(base * SCALE)
_scale() { awk "BEGIN{printf \"%d\", int($1 * ${SCALE} + 0.5)}"; }

# Font sizes pass through directly — SCALE doesn't affect them
export font_sz_ui="${FONT_UI}"
export font_sz_dunst="${FONT_DUNST}"
export font_sz_dmenu="${FONT_DMENU}"
# FONT_TERM, FONT_ZED_EDITOR, FONT_ZED_UI pass through directly to kitty/zed

# Pixel geometry scales with SCALE; XFT_DPI is set independently
export xft_dpi="${XFT_DPI}"
cursor_size="$(_scale "${BASE_CURSOR}")"; export cursor_size
border_px="$(_scale "${BASE_BORDER}")"; export border_px
gap_inner_px="$(_scale "${BASE_BORDER}")"; export gap_inner_px
ring_radius="$(_scale "${BASE_RING_RADIUS}")"; export ring_radius
ring_thick="$(_scale "${BASE_RING_THICK}")"; export ring_thick

export WALLPAPER_CMD="exec_always --no-startup-id feh --bg-fill ${wallpaper}"

# XSettings DPI: multiply by 1024 (XSettings integer format)
xft_dpi_xsettings="$(awk "BEGIN{printf \"%d\", ${XFT_DPI} * 1024}")"
export xft_dpi_xsettings

# GTK/icon theme follows dark/light mode
if [[ "${mode}" == "dark" ]]; then
    export gtk_theme="Yaru-dark"
    export icon_theme="Yaru-dark"
else
    export gtk_theme="Yaru"
    export icon_theme="Yaru"
fi

for conf in "$HOME/.config/wm"/conf/*.conf.in \
            "$HOME/.config/i3"/conf/*.conf.in \
            "$HOME/.config/i3status/config.in" \
            "$HOME/.config/dunst/dunstrc.in" \
            "$HOME/.config/xsettingsd/xsettingsd.conf.in" \
            "$HOME/.config/kitty/display.conf.in" \
            "$HOME/.Xresources.in"; do
    [[ -f "$conf" ]] || continue
    envsubst < "$conf" > "${conf%.in}"
done

xrdb -merge "$HOME/.Xresources"
xsetroot -cursor_name left_ptr
pkill -HUP xsettingsd 2>/dev/null || true
pkill -USR1 -x kitty 2>/dev/null || true
systemctl --user set-environment CHROMIUM_FLAGS="--force-device-scale-factor=${SCALE}"

# Zed: patch font sizes in-place, preserving comments and all other settings
# sed -i uses an atomic rename which triggers Zed's inotify watcher
sed -i "s/\"ui_font_size\": [0-9.]*/\"ui_font_size\": ${FONT_ZED_UI}/" \
    "$HOME/.config/zed/settings.json"
sed -i "s/\"buffer_font_size\": [0-9.]*/\"buffer_font_size\": ${FONT_ZED_EDITOR}/" \
    "$HOME/.config/zed/settings.json"
