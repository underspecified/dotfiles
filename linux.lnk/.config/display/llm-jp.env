#!/usr/bin/env bash
# Host display profile for llm-jp.
# seeded from 5k2k_34in.env — reconcile against this box at rollout
# (cp ~/.config/display/"$(readlink ~/.config/display/env)" here, then tune FONT_ZED_*).
#
# SCALE   — pixel geometry scaling only (cursor, borders).
# XFT_DPI — font rendering DPI (Xft.dpi). Independent of SCALE.
# FONT_*  — logical pt passed straight to each app.

export SCALE=2.0
export XFT_DPI=162.56
export QT_SCALE=2.0

# Font sizes (pt)
export FONT_UI=12
export FONT_DUNST=15
export FONT_DMENU=15
export FONT_TERM=10
export FONT_ZED_EDITOR=12
export FONT_ZED_UI=12

# Pixel geometry at 1× — multiplied by SCALE at runtime
export BASE_CURSOR=24
export BASE_BORDER=4
export BASE_RING_RADIUS=64
export BASE_RING_THICK=16
